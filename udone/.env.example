# Public Supabase configuration for the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_CAPTCHA_SITE_KEY=

# Server-only values belong in Worker secrets; never prefix them with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=

# Real deployed-stack smoke fixtures. Use a dedicated fictional test account
# and an existing organization ID; never point these at production user data.
SMOKE_BASE_URL=
SMOKE_SUPABASE_URL=
SMOKE_SUPABASE_PUBLISHABLE_KEY=
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
SMOKE_ORGANIZATION_ID=
SMOKE_NONMEMBER_ORGANIZATION_ID=
