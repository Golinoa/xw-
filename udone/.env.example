# Public Supabase configuration for the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_CAPTCHA_SITE_KEY=

# Server-only values belong in Worker secrets; never prefix them with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 项目 JWT secret。幂等中间件用它验签取 sub（跑在鉴权之前），不配则
# 幂等命名空间退化为令牌哈希，access token 一刷新就失效。
SUPABASE_JWT_SECRET=
APP_BASE_URL=

# 本地/CI 的自签令牌通道。只认字符串 'true'；生产禁止打开（见 check:deploy）。
# 不能拿「配了 SUPABASE_JWT_SECRET」当开关——生产也配它。
ALLOW_LOCAL_JWT_AUTH=false

# Browser origins allowed to call this API. Comma-separated, exact match, no wildcard.
# Leave blank to deny every cross-origin caller (same-origin SPA traffic still works).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5555
# Per-IP request ceiling enforced by the rate-limit middleware.
RATE_LIMIT_PER_MINUTE=60

# Real deployed-stack smoke fixtures. Use a dedicated fictional test account
# and an existing organization ID; never point these at production user data.
SMOKE_BASE_URL=
SMOKE_SUPABASE_URL=
SMOKE_SUPABASE_PUBLISHABLE_KEY=
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
SMOKE_ORGANIZATION_ID=
SMOKE_NONMEMBER_ORGANIZATION_ID=
