    "responseBody": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>登录 - 旅行社订单管理系统</title>\n    <link href=\"/vendor/bootstrap/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"/vendor/bootstrap-icons/bootstrap-icons.css\" rel=\"stylesheet\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: flex-start;\n            flex-direction: column;\n            padding-top: 5vh;\n            background: #f0f2f5;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n        }\n        .login-wrapper {\n            width: 900px;\n            min-height: 520px;\n            display: flex;\n            border-radius: 12px;\n            overflow: hidden;\n            box-shadow: 0 8px 40px rgba(0,0,0,.10);\n        }\n        .login-brand {\n            flex: 0 0 400px;\n            background: linear-gradient(150deg, #1a73e8 0%, #0d47a1 100%);\n            color: #fff;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            padding: 60px 40px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n        }\n        .login-brand::before {\n            content: '';\n            position: absolute;\n            top: -60px;\n            right: -60px;\n            width: 200px;\n            height: 200px;\n            border-radius: 50%;\n            background: rgba(255,255,255,.06);\n        }\n        .login-brand::after {\n            content: '';\n            position: absolute;\n            bottom: -40px;\n            left: -40px;\n            width: 160px;\n            height: 160px;\n            border-radius: 50%;\n            background: rgba(255,255,255,.04);\n        }\n        .login-brand .brand-icon {\n            width: 72px;\n            height: 72px;\n            background: rgba(255,255,255,.15);\n            border-radius: 18px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 34px;\n            margin-bottom: 24px;\n            position: relative;\n            z-index: 1;\n        }\n        .login-brand h2 {\n            font-size: 22px;\n            font-weight: 600;\n            letter-spacing: 1px;\n            margin-bottom: 8px;\n            position: relative;\n            z-index: 1;\n        }\n        .login-brand p {\n            font-size: 13px;\n            opacity: .65;\n            margin: 0;\n            position: relative;\n            z-index: 1;\n        }\n        .login-brand .features {\n            margin-top: 40px;\n            display: flex;\n            flex-direction: column;\n            gap: 14px;\n            position: relative;\n            z-index: 1;\n        }\n        .login-brand .features span {\n            font-size: 13px;\n            opacity: .75;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n        .login-form {\n            flex: 1;\n            background: #fff;\n            padding: 60px 50px;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n        }\n        .login-form h3 {\n            font-size: 24px;\n            font-weight: 700;\n            color: #1a1a1a;\n            margin-bottom: 6px;\n        }\n        .login-form .subtitle {\n            font-size: 13px;\n            color: #999;\n            margin-bottom: 36px;\n        }\n        .login-form .form-label {\n            font-size: 13px;\n            font-weight: 600;\n            color: #333;\n            margin-bottom: 6px;\n        }\n        .login-form .form-control {\n            border: 1.5px solid #e0e4e8;\n            border-radius: 8px;\n            padding: 11px 14px;\n            font-size: 14px;\n            transition: .2s;\n            background: #fafbfc;\n        }\n        .login-form .form-control:focus {\n            border-color: #1a73e8;\n            box-shadow: 0 0 0 3px rgba(26,115,232,.1);\n            background: #fff;\n        }\n        .login-form .input-group-text {\n            background: #fafbfc;\n            border: 1.5px solid #e0e4e8;\n            border-right: none;\n            border-radius: 8px 0 0 8px;\n            padding: 0 14px;\n            color: #8899a6;\n        }\n        .login-form .input-group .form-control {\n            border-left: none;\n            border-radius: 0 8px 8px 0;\n        }\n        .login-form .input-group:focus-within .input-group-text {\n            border-color: #1a73e8;\n            background: #fff;\n        }\n        .login-form .btn-login {\n            width: 100%;\n            padding: 12px;\n            font-size: 15px;\n            font-weight: 600;\n            border: none;\n            border-radius: 8px;\n            background: linear-gradient(150deg, #1a73e8, #0d47a1);\n            color: #fff;\n            cursor: pointer;\n            transition: .2s;\n            margin-top: 8px;\n            letter-spacing: 2px;\n        }\n        .login-form .btn-login:hover {\n            box-shadow: 0 4px 16px rgba(26,115,232,.3);\n            transform: translateY(-1px);\n        }\n        .login-form .form-check-input:checked {\n            background-color: #1a73e8;\n            border-color: #1a73e8;\n        }\n        .alert {\n            border: none;\n            border-radius: 8px;\n            font-size: 13px;\n            padding: 10px 14px;\n        }\n        @media (max-width: 768px) {\n            .login-wrapper { flex-direction: column; width: 360px; min-height: auto; }\n            .login-brand { flex: 0 0 auto; padding: 40px 30px; }\n            .login-brand .features { display: none; }\n            .login-form { padding: 36px 30px; }\n        }\n        .login-legal { text-align:center; padding:16px 0 26px; font-size:.75rem; color:#94a3b8; }\n        .login-legal a { color:#94a3b8; text-decoration:none; margin:0 8px; transition:color .15s; }\n        .login-legal a:hover { color:#3b82f6; }\n    </style>\n</head>\n<body>\n    <img src=\"https://trip.lipseo.com/images/feituoms.png\" alt=\"飞途旅游订单系统\" style=\"max-width:520px;height:auto;margin-bottom:20px;\" onerror=\"this.style.display='none'\">\n    <div class=\"login-wrapper\">\n        <div class=\"login-brand\">\n            <div class=\"brand-icon\">\n                <img src=\"https://trip.lipseo.com/images/feitu-ico.png\" alt=\"飞途\" style=\"width:80px;height:80px;object-fit:contain;border-radius:18px;\" onerror=\"this.style.display='none'\">\n            </div>\n            <h2>旅行社订单管理系统</h2>\n            <p>Travel Agency OMS</p>\n            <div class=\"features\">\n                <span><i class=\"bi bi-check-circle-fill opacity-75\" style=\"font-size:12px;\"></i> 订单全流程管理</span>\n                <span><i class=\"bi bi-check-circle-fill opacity-75\" style=\"font-size:12px;\"></i> 收支清晰可追溯</span>\n                <span><i class=\"bi bi-check-circle-fill opacity-75\" style=\"font-size:12px;\"></i> 数据统计一目了然</span>\n            </div>\n        </div>\n\n        <div class=\"login-form\">\n            <h3>欢迎回来</h3>\n            <p class=\"subtitle\">请输入用户名和密码登录系统</p>\n\n                        \n            <form method=\"POST\" action=\"https://trip.lipseo.com/login\">\n                <input type=\"hidden\" name=\"_token\" value=\"[REDACTED]\" autocomplete=\"off\">                <div class=\"mb-3\">\n                    <label class=\"form-label\">用户名或手机号</label>\n                    <div class=\"input-group\">\n                        <span class=\"input-group-text\"><i class=\"bi bi-person\"></i></span>\n                        <input type=\"text\" name=\"username\" class=\"form-control\" value=\"\" placeholder=\"用户名或手机号\" required autofocus>\n                    </div>\n                </div>\n                <div class=\"mb-3\">\n                    <label class=\"form-label\">密码</label>\n                    <div class=\"input-group\">\n                        <span class=\"input-group-text\"><i class=\"bi bi-lock\"></i></span>\n                        <input type=\"password\" name=\"password\" class=\"form-control\" placeholder=\"请输入密码\" required>\n                    </div>\n                </div>\n                <div class=\"d-flex justify-content-between align-items-center mb-4\">\n                    <div class=\"form-check\">\n                        <input type=\"checkbox\" name=\"remember\" class=\"form-check-input\" id=\"remember\">\n                        <label class=\"form-check-label small\" for=\"remember\">记住我</label>\n                    </div>\n                </div>\n                <button type=\"submit\" class=\"btn-login\">登 录</button>\n            </form>\n\n        </div>\n    </div>\n    </body>\n</html>\n",
