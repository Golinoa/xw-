{
  "name": "erp",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @erp/web --filter @erp/api dev",
    "format:write": "prettier --write \"apps/**/*.{js,ts,tsx,vue,json}\" \"packages/**/*.{js,ts,tsx,json}\" \"scripts/**/*.{js,mjs,ts,json}\" \"tests/**/*.{js,mjs,ts,json}\" \"*.{js,json,yml,yaml}\" \".github/**/*.{yml,yaml}\" \"../.workflow/**/*.{yml,yaml}\" \"../.release/*.json\" \"../scripts/release/*.mjs\" \"../package.json\" .prettierrc.json",
    "format:check": "prettier --check \"apps/**/*.{js,ts,tsx,vue,json}\" \"packages/**/*.{js,ts,tsx,json}\" \"scripts/**/*.{js,mjs,ts,json}\" \"tests/**/*.{js,mjs,ts,json}\" \"*.{js,json,yml,yaml}\" \".github/**/*.{yml,yaml}\" \"../.workflow/**/*.{yml,yaml}\" \"../.release/*.json\" \"../scripts/release/*.mjs\" \"../package.json\" .prettierrc.json",
    "format:sql:write": "node scripts/format-sql.mjs --write",
    "format:sql:check": "node scripts/format-sql.mjs --check",
    "lint": "eslint apps packages scripts tests eslint.config.mjs && pnpm css:tokens:check",
    "css:tokens:check": "node scripts/check-css-tokens.mjs",
    "typecheck": "pnpm --filter @erp/web --filter @erp/api typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @erp/web --filter @erp/api build",
    "check:deploy": "tsx scripts/check-deploy-config.ts",
    "deps:audit": "node scripts/check-deps-audit.mjs",
    "licenses:check": "pnpm licenses list --json | node scripts/check-license-policy.mjs",
    "secrets:check": "secretlint --maskSecrets --no-color \"**/*\"",
    "secrets:canary:check": "node scripts/check-secret-canary.mjs",
    "schema:generate": "node scripts/generate-db-schema.mjs --write",
    "schema:check": "node scripts/generate-db-schema.mjs --check",
    "db:test": "supabase test db --local",
    "db:local:setup": "node scripts/db/local-db.mjs setup",
    "db:local:verify": "node scripts/db/local-db.mjs verify",
    "db:local:http": "node scripts/db/local-db.mjs http",
    "smoke": "playwright test --config playwright.smoke.config.ts",
    "wrangler": "pnpm --filter @erp/api exec wrangler --config ../../wrangler.toml",
    "board:check": "node scripts/check-board.mjs",
    "deps:audit:raw": "pnpm audit --registry=https://registry.npmjs.org --json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "^24.10.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "sql-formatter": "15.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.12"
  }
}
