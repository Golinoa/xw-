# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址（同源相对路径；运营命名空间 /api/v1/ops 由 VITE_OPS_API_PREFIX 单独维护）
VITE_GLOB_API_URL=/api

# 运营 API 命名空间前缀（相对 VITE_GLOB_API_URL）
VITE_OPS_API_PREFIX=/v1/ops

# 跨源白名单：仅在 VITE_GLOB_API_URL 配成绝对地址时生效（逗号分隔来源）
VITE_OPS_API_ALLOWED_ORIGINS=

# 开发态契约桩：true 时使用 __stub__ 的虚构数据，页面顶部会出现黄色条幅提示
# 后端 ops 模块未实现期间可临时打开；提交代码前必须保持 false
VITE_OPS_MOCK=false

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
# 运营后台对接真实后端契约，演示 mock 会伪造成功响应，故关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
