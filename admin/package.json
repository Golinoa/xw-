{
  "name": "vben-admin-monorepo",
  "version": "5.7.0",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "vben",
    "vben admin",
    "vben pro",
    "vue",
    "vue admin",
    "vue vben admin",
    "vue vben admin pro",
    "vue3"
  ],
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": "vbenjs/vue-vben-admin.git",
  "license": "MIT",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:antd": "pnpm run build --filter=@vben/web-antd",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "pnpm run build --filter=@vben/docs",
    "build:ele": "pnpm run build --filter=@vben/web-ele",
    "build:naive": "pnpm run build --filter=@vben/web-naive",
    "build:tdesign": "pnpm run build --filter=@vben/web-tdesign",
    "build:play": "pnpm run build --filter=@vben/playground",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "pnpm --filter @vben/web-antd typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:antd": "pnpm -F @vben/web-antd run dev",
    "dev:antdv-next": "pnpm -F @vben/web-antdv-next run dev",
    "dev:docs": "pnpm -F @vben/docs run dev",
    "dev:ele": "pnpm -F @vben/web-ele run dev",
    "dev:naive": "pnpm -F @vben/web-naive run dev",
    "dev:tdesign": "pnpm -F @vben/web-tdesign run dev",
    "dev:play": "pnpm -F @vben/playground run dev",
    "format": "vsh lint --format",
    "format:check": "oxfmt --check --threads=2 \"apps/web-antd/**/*.{ts,tsx,vue,js,jsx,mjs,cjs,json,jsonc,yaml,yml,css,scss,less,html}\" \"packages/**/*.{ts,tsx,vue,js,jsx,mjs,cjs,json,jsonc,yaml,yml,css,scss,less,html}\" \"internal/**/*.{ts,tsx,vue,js,jsx,mjs,cjs,json,jsonc,yaml,yml,css,scss,less,html}\" \"scripts/**/*.{ts,tsx,vue,js,jsx,mjs,cjs,json,jsonc,yaml,yml,css,scss,less,html}\" package.json pnpm-workspace.yaml lefthook.yml .github/workflows/frontend-quality.yml .secretlintrc.json .harness/license-policy.json",
    "lint": "vsh lint",
    "lint:check": "oxlint --threads=2 apps/web-antd && eslint apps/web-antd/src --ext .ts,.vue && stylelint \"apps/web-antd/src/**/*.{vue,css,less,scss}\" --cache",
    "postinstall": "pnpm -r --filter @vben/web-antd... --filter @vben/vsh... --filter @vben/vite-config... --filter @vben/eslint-config... --filter @vben/oxfmt-config... --filter @vben/oxlint-config... --filter @vben/stylelint-config... run stub --if-present",
    "preinstall": "node scripts/quality/check-toolchain.mjs",
    "prepare": "is-ci || pnpm exec lefthook install",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "pnpm --filter @vben/web-antd run test:unit",
    "quality:toolchain": "node scripts/quality/check-toolchain.mjs",
    "quality:dependencies": "pnpm --registry=https://registry.npmjs.org audit --audit-level high",
    "quality:licenses": "node scripts/quality/check-licenses.mjs",
    "quality:secret-scan": "secretlint \"**/*\" \".*\" \"**/.*\" --no-terminalLink",
    "quality:negative": "node scripts/quality/verify-quality-gates.mjs",
    "quality:bundle-secrets": "node scripts/quality/check-bundle-secrets.mjs",
    "quality:check": "pnpm run quality:toolchain && pnpm run format:check && pnpm run lint:check && pnpm run check:type && pnpm run test:unit && pnpm run build:antd && pnpm run quality:licenses && pnpm run quality:secret-scan && pnpm run quality:bundle-secrets && pnpm run quality:negative && pnpm run quality:dependencies",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "license-checker-rseidelsohn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "secretlint": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.33.4"
  },
  "packageManager": "pnpm@10.33.4"
}
