VITE_BASE=/

# 接口地址：同源部署，固定 /api（运营命名空间 /api/v1/ops）
# 首次部署换域名时只改运行时 _app.config.js，不需要重新构建
VITE_GLOB_API_URL=/api

# 运营 API 命名空间前缀（相对 VITE_GLOB_API_URL）
VITE_OPS_API_PREFIX=/v1/ops

# 跨源白名单：同源部署时必须为空；改成绝对地址时在此登记来源（逗号分隔）
VITE_OPS_API_ALLOWED_ORIGINS=

# 生产构建禁止开启开发态契约桩（置 true 时启动校验会直接抛错）
VITE_OPS_MOCK=false

# 生产构建禁止开启 Nitro Mock
VITE_NITRO_MOCK=false

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
