# e2e 专用环境（Playwright webServer 以 --mode e2e 启动）
#
# 与 .env.development 的差异仅一处：VITE_OPS_MOCK=true。
# 原因：后端 ops API 尚未实现，e2e 只能验证「前端骨架 + 契约桩」的行为，
# 不能冒充真实后端集成。真实联调的 e2e 需在阶段 4 另建 env 与用例。
#
# 本文件不含任何密钥，可提交。

VITE_PORT=5666
VITE_BASE=/

VITE_GLOB_API_URL=/api
VITE_OPS_API_PREFIX=/v1/ops
VITE_OPS_API_ALLOWED_ORIGINS=

# 开发态契约桩：e2e 必须为 true，否则登录接口不可达
VITE_OPS_MOCK=true

VITE_NITRO_MOCK=false
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=false
